# Copie este arquivo para .env (local) ou cadastre as variáveis no painel da Vercel.
# NUNCA faça commit do arquivo .env com valores reais.

# Conta que envia o e-mail (Gmail: use uma "Senha de app", não a sua senha normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Quem recebe as mensagens (se vazio, usa SMTP_USER)
MAIL_TO=brunohms2705@gmail.com
MAIL_FROM_NAME=Portfólio Bruno Henrique

# Chave secreta para assinar os tokens anti-robô do formulário.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_SECRET=

# Opcional: domínios autorizados a usar o formulário, separados por vírgula.
# Se vazio, aceita apenas o próprio domínio onde o site está publicado.
ALLOWED_ORIGINS=
